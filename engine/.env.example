# Shared secret between dashboard and engine. Generate: openssl rand -hex 32
ENGINE_API_KEY=
PORT=4000
# Keep the engine private (127.0.0.1 or a private network). Never expose it to the internet.
HOST=127.0.0.1
DB_PATH=./data/engine.db

# --- Rotating egress -------------------------------------------------------
# AWS API Gateway rotation: run `npm run gateways -- create` (needs AWS credentials), then:
# AWS_GATEWAYS_FILE=./gateways.json
# AWS_GATEWAY_REGIONS=us-east-1,us-west-2,eu-west-1,eu-central-1,ap-south-1,ap-southeast-1
# And/or plain forward proxies (comma separated), e.g. squid on EC2 or a residential provider:
# PROXY_URLS=http://user:pass@host1:3128,http://user:pass@host2:3128

# --- Signed-in platforms (Instagram, X, Reddit) -------------------------------
# Sign in once with `npm run login`. These always use this machine's own connection.
# Browser the engine drives: chrome (default) or msedge
# BROWSER_CHANNEL=chrome
# The engine works in a normal Chrome window parked off-screen. Set to 1 to keep it on screen and watch.
# BROWSER_VISIBLE=1
# The browser closes itself after this many seconds without work and reopens when needed
# BROWSER_IDLE_SECONDS=90
# Hidden mode (1) is blocked by Reddit and limited by Instagram; leave it off.
# BROWSER_HEADLESS=0
# Instagram posts per keyword that get an extra lookup for views/likes
INSTAGRAM_ENRICH_TOP=40
# Seconds between keywords and keywords per day
GAP_SECONDS_INSTAGRAM=60
GAP_SECONDS_TWITTER=40
GAP_SECONDS_REDDIT=12
DAILY_CAP_INSTAGRAM=700
DAILY_CAP_TWITTER=900
# Optional, Reddit only: if Reddit keeps blocking the browser, create a free developer app at
# https://www.reddit.com/prefs/apps (type "script") and paste its id and secret here.
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# Hours a platform rests after it rate-limits or challenges the account
ACCOUNT_COOLDOWN_HOURS=6

# --- Brand analysis (official handles) ----------------------------------------
# Months read back per handle, most posts kept per handle, and how many Instagram posts get an extra lookup
# PROFILE_MONTHS=12
# PROFILE_MAX_POSTS=600
# PROFILE_ENRICH_TOP=150

# --- Tuning ------------------------------------------------------------------
REGION=IN
LANG_CODE=en
RESULT_LIMIT=100
# Candidates gathered per keyword before ranking down to RESULT_LIMIT
POOL_SIZE=300
# Results are collected once and change only when someone clicks Refresh now.
# Set a number of hours here to re-collect everything automatically instead.
# AUTO_REFRESH_HOURS=0
CONCURRENCY=4
PER_PLATFORM_CONCURRENCY=1
HOST_MIN_INTERVAL_MS=1200
# YouTube videos per keyword that get likes, comments and upload date (one extra page each)
YOUTUBE_ENRICH_TOP=100
