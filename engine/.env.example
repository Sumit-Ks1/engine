# Shared secret between dashboard and engine. Generate: openssl rand -hex 32
ENGINE_API_KEY=
PORT=4000
# Keep the engine private (127.0.0.1 or a private network). Never expose it to the internet.
HOST=127.0.0.1
DB_PATH=./data/engine.db

# --- Rotating egress -------------------------------------------------------
# AWS API Gateway rotation: run `npm run gateways -- create` (needs AWS credentials), then:
# AWS_GATEWAYS_FILE=./gateways.json
# AWS_GATEWAY_REGIONS=us-east-1,us-west-2,eu-west-1,eu-central-1,ap-south-1,ap-southeast-1
# And/or plain forward proxies (comma separated), e.g. squid on EC2 or a residential provider:
# PROXY_URLS=http://user:pass@host1:3128,http://user:pass@host2:3128

# --- Tuning ------------------------------------------------------------------
REGION=IN
LANG_CODE=en
RESULT_LIMIT=100
REFRESH_HOURS=12
CONCURRENCY=4
PER_PLATFORM_CONCURRENCY=1
HOST_MIN_INTERVAL_MS=1200
YOUTUBE_ENRICH_TOP=30
