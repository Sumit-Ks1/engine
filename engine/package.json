{
  "name": "trend-engine",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "gateways": "tsx --env-file-if-exists=.env scripts/aws-gateways.ts",
    "predev": "node scripts/check-node.cjs",
    "prestart": "node scripts/check-node.cjs",
    "pretest": "node scripts/check-node.cjs",
    "login": "node scripts/check-node.cjs && tsx --env-file-if-exists=.env scripts/login.ts"
  },
  "dependencies": {
    "fastify": "^5.2.0",
    "playwright-core": "^1.63.0",
    "undici": "^7.2.0"
  },
  "devDependencies": {
    "@aws-sdk/client-api-gateway": "^3.700.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
